# PostgreSQL (apache/age)
POSTGRES_USER=usfds
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=usfds
POSTGRES_PORT=5400

# RustFS (S3-compatible object storage)
RUSTFS_ACCESS_KEY=usfds-access-key
RUSTFS_SECRET_KEY=change-me-rustfs-secret
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
USFDS_S3_BUCKET=usfds
USFDS_S3_REGION=us-east-1
USFDS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# App containers (compose profile `app`)
USFDS_SERVER_PORT=8000
USFDS_WORKER_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Running usfds-server / usfds-worker directly on the host (outside compose):
#   USFDS_DB_URL=postgresql+psycopg://usfds:change-me-postgres@localhost:5432/usfds
#   USFDS_STORAGE_BACKEND=s3
#   USFDS_S3_ENDPOINT_URL=http://localhost:9000
#   USFDS_S3_BUCKET=usfds
#   USFDS_S3_ACCESS_KEY=usfds-access-key
#   USFDS_S3_SECRET_KEY=change-me-rustfs-secret
#   USFDS_S3_REGION=us-east-1
#   USFDS_DISPATCH_BACKEND=queue
# Leave USFDS_DB_URL unset to keep the desktop defaults (SQLite + local storage + in-process dispatch).
# ---------------------------------------------------------------------------
