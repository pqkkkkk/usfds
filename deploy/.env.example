# PostgreSQL (apache/age)
POSTGRES_USER=usfds
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=usfds
POSTGRES_PORT=5400

# RustFS (S3-compatible object storage)
RUSTFS_ACCESS_KEY=usfds-access-key
RUSTFS_SECRET_KEY=change-me-rustfs-secret
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
USFDS_S3_BUCKET=usfds
USFDS_S3_REGION=us-east-1
USFDS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# App containers
USFDS_SERVER_PORT=8000
USFDS_WEB_PORT=5173
USFDS_WORKER_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Running usfds-server / usfds-worker directly on the host (outside compose):
#   USFDS_DB_URL=postgresql+psycopg://usfds:change-me-postgres@localhost:5432/usfds
#   USFDS_STORAGE_BACKEND=s3
#   USFDS_S3_ENDPOINT_URL=http://localhost:9000
#   USFDS_S3_BUCKET=usfds
#   USFDS_S3_ACCESS_KEY=usfds-access-key
#   USFDS_S3_SECRET_KEY=change-me-rustfs-secret
#   USFDS_S3_REGION=us-east-1
#   USFDS_DISPATCH_BACKEND=queue
# Leave USFDS_DB_URL unset to keep the desktop defaults (SQLite + local storage + in-process dispatch).
# ---------------------------------------------------------------------------

# Authentication & RBAC (Client-Server)
USFDS_AUTH_MODE=required
USFDS_JWT_SECRET=change-me-use-a-long-random-secret
USFDS_ACCESS_TOKEN_EXPIRE_MINUTES=30
USFDS_REFRESH_TOKEN_EXPIRE_DAYS=7
USFDS_BOOTSTRAP_ADMIN_USERNAME=admin
USFDS_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
USFDS_CORS_ORIGINS=http://localhost:5173
USFDS_MAX_PLUGIN_UPLOAD_MB=10
USFDS_QUEUE_WAIT_TIMEOUT_SECONDS=300
USFDS_ANALYTICS_WAIT_TIMEOUT_SECONDS=120
USFDS_GRAPH_CACHE_MAX_ENTRIES=4
USFDS_GRAPH_CACHE_TTL_SECONDS=600
USFDS_GRAPH_BUFFER_POOL_MB=256
USFDS_GRAPH_SUPER_NODE_DEGREE=50
