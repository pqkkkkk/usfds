# Build from the repository root: docker build -f deploy/Dockerfile.web .
FROM node:22-alpine AS builder

WORKDIR /app
COPY usfds-web/package.json usfds-web/package-lock.json ./
RUN npm ci

COPY usfds-web/ ./
RUN npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

